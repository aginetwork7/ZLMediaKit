REGISTRY=672340652820.dkr.ecr.us-west-1.amazonaws.com
ZLM_TAG=0.0.2-beta.4
#control service URL，example only
MEDIA_CONTROL_HOST=host.docker.internal
MEDIA_CONTROL_PORT=8088
MEDIA_SERVICE_HOOK_BASE_URL=http://host.docker.internal:8088/agi7/api/media-control/hook
# 必填：替换为本环境的 secret（例如 openssl rand -hex 16）；保留 CHANGE_ME 时容器拒绝启动
# Required: replace with this environment's secret (e.g. openssl rand -hex 16); the container refuses to start with CHANGE_ME
MEDIA_SERVER_SECRET=CHANGE_ME
#节点部署模式，sfu 或 media
MEDIA_CONFIG_TYPE=sfu
#节点id, MEDIA_CONFIG_TYPE=sfu 必填
MEDIA_SERVER_ID="demo-52.35.161.132:8080"
# WebRTC对外通告地址（公网IP/EIP），MEDIA_CONFIG_TYPE=sfu 必填
EXTERN_IP=52.35.161.132
MEDIA_ALLOW_IP_RANGE="::1,127.0.0.1,172.16.0.0-172.31.255.255,192.168.0.0-192.168.255.255,10.0.0.0-10.255.255.255,52.35.161.132"
METRICS_INTERVAL_SEC=10
# 必填：fluent-bit 上报主机指标的 Bearer token，须与 media-control 的 SYSTEM_METRICS_TOKEN 相同
# Required: bearer token fluent-bit uses for host metrics; must equal media-control's SYSTEM_METRICS_TOKEN
SYSTEM_METRICS_TOKEN=CHANGE_ME
# 本环境 ZLM 在宿主机映射的 HTTP 端口（ports 中 8080 的宿主机端口），exporter 经 host.docker.internal 访问
ZLM_HTTP_PORT=8080
# zlm-exporter 镜像版本（${REGISTRY}/zlm-exporter），供中心 Prometheus 拉取指标
ZLM_EXPORTER_TAG=0.0.1-alpha.2
# zlm-exporter 对外端口，安全组仅放行 Prometheus 来源 IP
ZLM_EXPORTER_PORT=9101
